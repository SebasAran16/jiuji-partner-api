# Deployment environment: develop | staging | production
# Controls environment-gated behavior — e.g. the convenience admin user is
# seeded only when this is NOT production.
ENV=develop
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/jiuji_partner
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-in-production
JWT_EXPIRATION=7d
PORT=3001

# Mail (local: Mailpit, production: SendGrid)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@jiujipartner.com
FRONTEND_URL=http://localhost:3000

# Google Drive
GOOGLE_API_KEY=

# --- AI providers ---
# The local Ollama/Whisper containers exist ONLY to avoid API spend while
# developing. Production runs Qdrant only; LLM + transcription will come from
# managed providers (not chosen yet). When they are, implement them in
# LlmService / TranscriptionService and switch the *_PROVIDER values here.

# LLM + embeddings (local/dev: ollama)
AI_PROVIDER=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window for chat/vision/JSON calls. Ollama defaults to 2048, which
# truncates a full video's captions+transcript (~10k+ tokens) and silently
# breaks matching/description/chat. Raise to fit; bounded by GPU VRAM.
OLLAMA_NUM_CTX=16384
# Movement matching + description split a video's evidence into time-windows so
# any-length video is processed without overflowing the context window. Token
# budget per window (keep well under OLLAMA_NUM_CTX to leave room for the system
# prompt + JSON output) and the overlap between windows so a technique spanning
# a boundary isn't missed. A short video fits one window (single call).
MATCH_CHUNK_TOKENS=6000
MATCH_CHUNK_OVERLAP_SECONDS=30
# Production placeholders (provider TBD):
# AI_PROVIDER=
# AI_API_KEY=
# AI_API_URL=

# Transcription (local/dev: whisper-local container)
TRANSCRIPTION_PROVIDER=whisper-local
WHISPER_URL=http://whisper:9000
# Production placeholders (provider TBD):
# TRANSCRIPTION_PROVIDER=
# TRANSCRIPTION_API_KEY=

# Vector DB (runs in BOTH local and production)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=videos

# --- Video-import pipeline timeouts (all milliseconds) ---
# Bull fails a job that exceeds VIDEO_IMPORT_JOB_TIMEOUT_MS, and the processor
# aborts the work in flight just before that so nothing is left running. 45 min
# is ~2-3x the worst realistic video (24 frames x ~21s of captioning + decode +
# transcription), with headroom for a larger frame budget later.
VIDEO_IMPORT_JOB_TIMEOUT_MS=2700000
# Per-operation deadlines. Each MUST stay below the job timeout so a hang is
# reported against the stage that caused it instead of the job as a whole.
VIDEO_DOWNLOAD_TIMEOUT_MS=1200000
FFPROBE_TIMEOUT_MS=60000
FFMPEG_TIMEOUT_MS=1800000
WHISPER_TIMEOUT_MS=1200000
# One inference call (caption, description, movement matching, RAG chat). A
# caption measures ~21s on the reference GPU; 2 min means it is stuck.
OLLAMA_REQUEST_TIMEOUT_MS=120000
