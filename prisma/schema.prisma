datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Belt {
  WHITE
  BLUE
  PURPLE
  BROWN
  BLACK
}

enum Objective {
  COMPETITION
  RECREATIONAL
  SELF_DEFENSE
  CONDITIONING
  TECHNICAL_DEVELOPMENT
}

enum Intensity {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum Role {
  USER
  ADMIN
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id                         String     @id @default(uuid())
  email                      String     @unique
  passwordHash               String     @map("password_hash")
  firstName                  String?    @map("first_name")
  lastName                   String?    @map("last_name")
  belt                       Belt       @default(WHITE)
  stripes                    Int        @default(0)
  age                        Int?
  weight                     Float?
  bjjAcademy                 String?    @map("bjj_academy")
  timeTraining               Int?       @map("time_training")
  trainingsPerWeek           Int?       @map("trainings_per_week")
  objective                  Objective?
  intensity                  Intensity?
  avatarUrl                  String?    @map("avatar_url")
  role                       Role       @default(USER)
  isVerified                 Boolean    @default(false) @map("is_verified")
  verificationToken          String?    @unique @map("verification_token")
  verificationTokenExpiresAt DateTime?  @map("verification_token_expires_at")
  createdAt                  DateTime   @default(now()) @map("created_at")
  updatedAt                  DateTime   @updatedAt @map("updated_at")

  sessions TrainingSession[]

  @@map("users")
}

model TrainingSession {
  id               String                    @id @default(uuid())
  userId           String                    @map("user_id")
  date             DateTime                  @default(now())
  durationMinutes  Int                       @map("duration_minutes")
  intensityFeeling Int                       @map("intensity_feeling")
  notes            String?
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")
  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements        TrainingSessionMovement[]

  @@map("training_sessions")
}

model TrainingSessionMovement {
  id               String          @id @default(uuid())
  sessionId        String          @map("session_id")
  movementId       String          @map("movement_id")
  timeSpentMinutes Int             @map("time_spent_minutes")
  notes            String?
  session          TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  movement         Movement        @relation(fields: [movementId], references: [id])

  @@map("training_session_movements")
}

model Movement {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  category    String
  type        String
  minBelt     Belt     @default(WHITE) @map("min_belt")
  gi          Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  sessionMovements TrainingSessionMovement[]
  videoMovements    VideoMovement[]

  @@map("movements")
}

model Video {
  id               String           @id @default(uuid())
  title            String
  description      String?
  url              String
  thumbnailUrl     String?          @map("thumbnail_url")
  duration         Int?
  competitor       String?
  competition      String?
  tags             String[]
  processingStatus ProcessingStatus @default(PENDING) @map("processing_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  movements VideoMovement[]

  @@map("videos")
}

model VideoMovement {
  id             String   @id @default(uuid())
  videoId        String   @map("video_id")
  movementId     String   @map("movement_id")
  timestampStart Int?     @map("timestamp_start")
  timestampEnd   Int?     @map("timestamp_end")
  confidence     Float?
  createdAt      DateTime @default(now()) @map("created_at")

  video    Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  movement Movement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@map("video_movements")
}
